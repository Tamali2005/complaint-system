# Copy this file to ".env" for local testing. NEVER upload .env to GitHub.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres
SECRET_KEY=put-a-long-random-string-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_EMAIL=you@example.com
# Optional (for proof file upload to Supabase Storage)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key
SUPABASE_BUCKET=proofs
# Set to 1 on Render (https)
SESSION_COOKIE_SECURE=0
